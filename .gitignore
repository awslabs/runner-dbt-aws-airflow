# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual envs
.venv/
venv/

# uv
# (uv.lock is committed; the cache is not)

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# dbt
target/
dbt_packages/
logs/

# Airflow local state (created when running the example DAGs locally)
.airflow/

# runner-dbt-aws-airflow archive cache (built by build_project_archive at
# DAG load time). Lives outside the dbt project AND outside the Airflow
# dags folder.
.dbt_aws_cache/

# MWAA provisioning logs (used during local MWAA experiments; not part
# of the repo's source).
.mwaa_logs/

# mkdocs build output (regenerated by ``uv run mkdocs build``). NOT
# tracked, EXCEPT the ``site/.gitkeep`` placeholder which keeps the
# directory present in fresh clones. Hatchling's
# ``[tool.hatch.build.targets.wheel.force-include]`` references
# ``site/`` and raises FileNotFoundError during editable installs
# (``uv sync`` / ``pip install -e``) when the directory doesn't
# exist -- CI + fresh contributors hit this before their first
# ``mkdocs build`` run.
#
# ``uv build --wheel`` is still preceded by ``mkdocs build --strict``
# so the released wheel ships the real HTML, not the empty stub.
/site/*
!/site/.gitkeep

# Local-maintainer-only helpers directory. Kept entirely out of git
# because production publishing runs via OIDC trusted publishing in
# ``.github/workflows/publish-*.yml`` and the CI wheel smoke test lives
# inline in ``.github/actions/wheel-smoke/action.yml``. Any scripts
# under ``scripts/`` are for maintainer convenience only (local
# publish fallback, ad-hoc smoke, etc.) and live on maintainers'
# workstations.
/scripts/

# Test suite is kept local for the initial public release. Will be
# re-added once the fixtures / integration guides are hardened for
# external contributors. CI runs ruff + mypy + build + wheel smoke
# only until then.
/tests/

# Old ``archive/`` / ``attic/`` directories from the internal repo are
# not shipped here; if you copy them in locally, keep them out of git.
/attic/
/archive/
_local_verify/
